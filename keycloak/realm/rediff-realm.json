{
  "realm": "rediff",
  "enabled": true,
  "displayName": "Rediff",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "clients": [
    {
      "clientId": "rediff-web",
      "name": "Rediff Web Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "tenant-slug",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_slug",
            "claim.name": "tenant_slug",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo.user",
      "enabled": true,
      "email": "demo.user@rediff.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "attributes": {
        "tenant_slug": [
          "demo"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ]
    }
  ]
}
